# .gitignore for fuzzing-experiments

# Build outputs
build/
*.o
*.a
*.lib
*.pdb

# Fuzzer corpus (can grow very large; commit seeds separately)
corpus/

# Generated reports (except placeholder)
reports/*
!reports/.gitkeep

# Coverage data
*.profraw
*.profdata
*.lcov

# CodeQL database
codeql_db/

# Doom 3 BFG source (populated by clone_doom.sh / fuzz.ps1, not committed)
src/doom-3-bfg/

# Nested repo clone — safety net in case fuzz.ps1 is run from inside the repo
fuzzing-experiments/

# Python
__pycache__/
*.pyc

# Editor
.vscode/
.idea/
*.swp
