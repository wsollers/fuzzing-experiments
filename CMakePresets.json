{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },

  "configurePresets": [

    {
      "name": "_base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "_windows_base",
      "hidden": true,
      "inherits": "_base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "_windows_clang_base",
      "hidden": true,
      "inherits": "_base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_LINKER":       "lld-link"
      }
    },
    {
      "name": "_linux_base",
      "hidden": true,
      "inherits": "_base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },

    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "MSVC debug build, no fuzzing",
      "inherits": "_windows_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":  "Debug",
        "ENABLE_FUZZING":    "OFF",
        "ENABLE_ASAN":       "OFF"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "description": "MSVC optimised release build, no fuzzing",
      "inherits": "_windows_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":  "Release",
        "ENABLE_FUZZING":    "OFF",
        "ENABLE_ASAN":       "OFF"
      }
    },
    {
      "name": "windows-msvc-fuzz",
      "displayName": "Windows MSVC Fuzz (VS 2022 17.0+)",
      "description": "MSVC LibFuzzer build with ASan. Requires VS 2022 17.0+.",
      "inherits": "_windows_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":  "RelWithDebInfo",
        "ENABLE_FUZZING":    "ON",
        "ENABLE_ASAN":       "ON",
        "ENABLE_UBSAN":      "OFF",
        "ENABLE_COVERAGE":   "ON"
      }
    },

    {
      "name": "windows-clang-debug",
      "displayName": "Windows clang-cl Debug",
      "description": "clang-cl debug build, no fuzzing",
      "inherits": "_windows_clang_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":  "Debug",
        "ENABLE_FUZZING":    "OFF",
        "ENABLE_ASAN":       "OFF"
      }
    },
    {
      "name": "windows-clang-fuzz",
      "displayName": "Windows clang-cl Fuzz",
      "description": "clang-cl LibFuzzer build with ASan + UBSan. Requires LLVM for Windows.",
      "inherits": "_windows_clang_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":  "RelWithDebInfo",
        "ENABLE_FUZZING":    "ON",
        "ENABLE_ASAN":       "ON",
        "ENABLE_UBSAN":      "ON",
        "ENABLE_COVERAGE":   "ON"
      }
    },

    {
      "name": "linux-clang-fuzz",
      "displayName": "Linux Clang Fuzz",
      "description": "Linux Clang LibFuzzer build with ASan + UBSan",
      "inherits": "_linux_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":  "RelWithDebInfo",
        "ENABLE_FUZZING":    "ON",
        "ENABLE_ASAN":       "ON",
        "ENABLE_UBSAN":      "ON",
        "ENABLE_COVERAGE":   "ON"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "description": "Linux Clang optimised build, no fuzzing",
      "inherits": "_linux_base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE":  "Release",
        "ENABLE_FUZZING":    "OFF",
        "ENABLE_ASAN":       "OFF"
      }
    }
  ],

  "buildPresets": [
    { "name": "windows-msvc-debug",   "configurePreset": "windows-msvc-debug"   },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-fuzz",    "configurePreset": "windows-msvc-fuzz",    "jobs": 0 },
    { "name": "windows-clang-debug",  "configurePreset": "windows-clang-debug"  },
    { "name": "windows-clang-fuzz",   "configurePreset": "windows-clang-fuzz",   "jobs": 0 },
    { "name": "linux-clang-fuzz",     "configurePreset": "linux-clang-fuzz",     "jobs": 0 },
    { "name": "linux-clang-release",  "configurePreset": "linux-clang-release"  }
  ]
}
